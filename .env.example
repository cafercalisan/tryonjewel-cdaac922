# Database (bare metal PostgreSQL)
DATABASE_URL=postgresql://app:PASSWORD@localhost:5432/tryonjewel

# Auth (JWT)
JWT_SECRET=generate-a-random-64-char-string
JWT_REFRESH_SECRET=generate-another-random-64-char-string

# Storage (MinIO - S3 compatible)
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin

# Google AI
GOOGLE_API_KEY=your-google-api-key
GOOGLE_ANALYSIS_API_KEY=your-analysis-api-key
GOOGLE_VEO_API_KEY=your-veo-api-key

# Server
API_PORT=3001
ALLOWED_ORIGINS=

# Docker compose
DB_PASSWORD=your-db-password

# n8n Workflow Engine
USE_N8N=false
N8N_WEBHOOK_URL=http://n8n:5678/webhook/generate-jewelry
N8N_WEBHOOK_SECRET=n8n-tryonjewel-secret-2026
N8N_HOST=localhost
N8N_PROTOCOL=https
N8N_WEBHOOK_BASE_URL=https://your-domain.com/n8n-webhook/
N8N_ENCRYPTION_KEY=generate-a-random-32-char-string!!
