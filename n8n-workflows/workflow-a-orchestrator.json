    "Analyze Jewelry": { "main": [[{ "node": "Save Analysis", "type": "main", "index": 0 }]] },
    "Save Analysis": { "main": [[{ "node": "Brand DNA", "type": "main", "index": 0 }]] },
    "Brand DNA": { "main": [[{ "node": "Determine Scenes", "type": "main", "index": 0 }]] },
