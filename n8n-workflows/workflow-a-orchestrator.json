    {
      "parameters": {
        "method": "POST",
        "url": "http://10.0.1.1:3080/api/n8n/trigger",
        "sendHeaders": true,
        "headerParameters": { "parameters": [{ "name": "X-N8N-Secret", "value": "n8n-tryonjewel-secret-2026" }] },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ action: 'fetch-brand-dna', userId: $('Validate Secret').first().json.userId }) }}",
        "options": { "timeout": 10000 }
      },
      "id": "fetch-brand-dna",
      "name": "Fetch Brand DNA",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1540, 300]
    },
    {
      "parameters": {
        "jsCode": "// Determine which scenes to generate based on package type\nconst input = $('Validate Secret').first().json;\nconst { packageType, selectedScenes, customPrompt } = input;\n\nlet scenes = [];\nif (packageType === 'retouch') {\n  scenes = ['retouch'];\n} else if (packageType === 'single') {\n  scenes = [customPrompt ? 'custom' : 'editorial'];\n} else {\n  // Standard/master package\n  scenes = selectedScenes && selectedScenes.length > 0\n    ? selectedScenes\n    : ['editorial', 'ecommerce', 'model', 'macro', 'model_closeup', 'model_lifestyle'];\n}\n\n// Create array of scene items for looping\nreturn scenes.map((scene, i) => ({\n  json: {\n    sceneType: scene,\n    sceneIndex: i,\n    totalScenes: scenes.length\n  }\n}));"
      },
      "id": "determine-scenes",
      "name": "Determine Scenes",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1760, 300]
    },
    {
      "parameters": {
        "batchSize": 1,
        "options": {}
      },
      "id": "loop-scenes",
      "name": "Loop Scenes",
      "type": "n8n-nodes-base.splitInBatches",
      "typeVersion": 3.1,
      "position": [1980, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://10.0.1.1:3080/api/n8n/trigger",
        "sendHeaders": true,
        "headerParameters": { "parameters": [{ "name": "X-N8N-Secret", "value": "n8n-tryonjewel-secret-2026" }] },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ action: 'update-job', jobId: $('Validate Secret').first().json.jobId, currentStep: 'generating_' + $json.sceneType, progress: Math.round(25 + ($json.sceneIndex * 65 / $json.totalScenes)), totalImages: $json.totalScenes }) }}",
        "options": { "timeout": 10000 }
      },
      "id": "update-progress",
      "name": "Update Progress",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [2200, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://10.0.1.1:3080/api/n8n/trigger",
        "sendHeaders": true,
        "headerParameters": { "parameters": [{ "name": "X-N8N-Secret", "value": "n8n-tryonjewel-secret-2026" }] },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ action: 'generate-scene', base64Images: $('Download Images').first().json.base64Images, sceneType: $('Loop Scenes').first().json.sceneType, analysisResult: $('Analyze Jewelry').first().json.analysisResult, userId: $('Validate Secret').first().json.userId, imageRecordId: $('Validate Secret').first().json.imageRecordId, jobId: $('Validate Secret').first().json.jobId, aspectRatio: $('Validate Secret').first().json.aspectRatio || '3:4', productType: $('Validate Secret').first().json.productType, metalColorOverride: $('Validate Secret').first().json.metalColorOverride, customPrompt: $('Validate Secret').first().json.customPrompt, brandDna: $('Fetch Brand DNA').first().json.brandDna }) }}",
        "options": { "timeout": 300000 }
      },
      "id": "generate-scene",
      "name": "Generate Scene",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [2420, 300],
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "jsCode": "// Collect generated URL and feed back to loop\nconst result = $input.first().json;\nconst sceneInfo = $('Loop Scenes').first().json;\n\n// Get existing collected URLs or start fresh\nconst existingUrls = $('Loop Scenes').first().json._collectedUrls || [];\nif (result.success && result.url) {\n  existingUrls.push(result.url);\n}\n\nreturn [{\n  json: {\n    ...sceneInfo,\n    _collectedUrls: existingUrls,\n    _lastResult: result.success ? 'ok' : (result.error || 'failed')\n  }\n}];"
      },
      "id": "collect-url",
      "name": "Collect URL",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [2640, 300]
    },
    {
      "parameters": {
        "jsCode": "// After all scenes: finalize\nconst input = $('Validate Secret').first().json;\nconst allItems = $input.all();\n\n// Collect all URLs from the loop results\nconst generatedUrls = [];\nfor (const item of allItems) {\n  const urls = item.json._collectedUrls || [];\n  for (const u of urls) {\n    if (u && !generatedUrls.includes(u)) generatedUrls.push(u);\n  }\n}\n\nreturn [{\n  json: {\n    ...input,\n    generatedUrls,\n    hasResults: generatedUrls.length > 0\n  }\n}];"
      },
      "id": "finalize",
      "name": "Finalize",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [2200, 100]
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "strict" },
          "conditions": [{
            "id": "has-results",
            "leftValue": "={{ $json.hasResults }}",
            "rightValue": true,
            "operator": { "type": "boolean", "operation": "equals" }
          }],
          "combinator": "and"
        }
      },
      "id": "if-has-results",
      "name": "IF Has Results",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [2420, 100]
    },
