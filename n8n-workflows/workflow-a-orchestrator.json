    "Collect Result": { "main": [[{ "node": "Loop Scenes", "type": "main", "index": 0 }]] },
    "Finalize": { "main": [[{ "node": "Has Results?", "type": "main", "index": 0 }]] },
    "Has Results?": { "main": [
      [{ "node": "Mark Completed", "type": "main", "index": 0 }],
      [{ "node": "Refund Credits", "type": "main", "index": 0 }]
    ]},
    "Mark Completed": { "main": [[{ "node": "Image Done", "type": "main", "index": 0 }]] },
