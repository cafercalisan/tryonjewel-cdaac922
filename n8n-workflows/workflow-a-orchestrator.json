{
  "id": "wf_jewelry_main",
  "name": "Jewelry Generation Orchestrator",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "generate-jewelry",
        "options": {}
      },
      "id": "a1",
      "name": "Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [0, 300],
      "webhookId": "generate-jewelry"
    },
    {
      "parameters": {
        "jsCode": "const body = $input.first().json.body;\nconst headers = $input.first().json.headers || {};\n\nconst secret = headers['x-webhook-secret'] || '';\nif (secret !== 'n8n-tryonjewel-secret-2026') {\n  throw new Error('Invalid webhook secret');\n}\n\nreturn [{ json: body }];"
      },
      "id": "a2",
      "name": "Validate",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [220, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://app:80/api/n8n/trigger",
        "sendHeaders": true,
        "headerParameters": { "parameters": [{ "name": "X-N8N-Secret", "value": "n8n-tryonjewel-secret-2026" }, { "name": "Content-Type", "value": "application/json" }] },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ action: 'update-job', jobId: $json.jobId, status: 'generating', currentStep: 'downloading', progress: 2 }) }}",
        "options": { "timeout": 10000 }
      },
      "id": "a3",
      "name": "Job Started",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [440, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://app:80/api/n8n/trigger",
        "sendHeaders": true,
        "headerParameters": { "parameters": [{ "name": "X-N8N-Secret", "value": "n8n-tryonjewel-secret-2026" }, { "name": "Content-Type", "value": "application/json" }] },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ action: 'download-images', imagePaths: $('Validate').first().json.imagePaths }) }}",
        "options": { "timeout": 30000 }
      },
      "id": "a4",
      "name": "Download Images",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [660, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://app:80/api/n8n/trigger",
        "sendHeaders": true,
        "headerParameters": { "parameters": [{ "name": "X-N8N-Secret", "value": "n8n-tryonjewel-secret-2026" }, { "name": "Content-Type", "value": "application/json" }] },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ action: 'update-job', jobId: $('Validate').first().json.jobId, currentStep: 'analyzing', progress: 10 }) }}",
        "options": { "timeout": 10000 }
      },
      "id": "a5",
      "name": "Job Analyzing",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [880, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://app:80/api/n8n/trigger",
        "sendHeaders": true,
        "headerParameters": { "parameters": [{ "name": "X-N8N-Secret", "value": "n8n-tryonjewel-secret-2026" }, { "name": "Content-Type", "value": "application/json" }] },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ action: 'analyze-jewelry', base64Images: $('Download Images').first().json.base64Images }) }}",
        "options": { "timeout": 60000 }
      },
      "id": "a6",
      "name": "Analyze Jewelry",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1100, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://app:80/api/n8n/trigger",
        "sendHeaders": true,
        "headerParameters": { "parameters": [{ "name": "X-N8N-Secret", "value": "n8n-tryonjewel-secret-2026" }, { "name": "Content-Type", "value": "application/json" }] },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ action: 'update-image', imageRecordId: $('Validate').first().json.imageRecordId, status: 'generating', analysisData: $('Analyze Jewelry').first().json.analysisResult }) }}",
        "options": { "timeout": 10000 }
      },
      "id": "a7",
      "name": "Save Analysis",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1320, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://app:80/api/n8n/trigger",
        "sendHeaders": true,
        "headerParameters": { "parameters": [{ "name": "X-N8N-Secret", "value": "n8n-tryonjewel-secret-2026" }, { "name": "Content-Type", "value": "application/json" }] },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ action: 'fetch-brand-dna', userId: $('Validate').first().json.userId }) }}",
        "options": { "timeout": 10000 }
      },
      "id": "a8",
      "name": "Brand DNA",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1540, 300]
    },
    {
      "parameters": {
        "jsCode": "const input = $('Validate').first().json;\nconst { packageType, selectedScenes, customPrompt } = input;\n\nlet scenes = [];\nif (packageType === 'retouch') {\n  scenes = ['retouch'];\n} else if (packageType === 'single') {\n  scenes = [customPrompt ? 'custom' : 'editorial'];\n} else {\n  scenes = (selectedScenes && selectedScenes.length > 0)\n    ? selectedScenes\n    : ['editorial', 'ecommerce', 'model', 'macro', 'model_closeup', 'model_lifestyle'];\n}\n\nreturn scenes.map((scene, i) => ({\n  json: { sceneType: scene, sceneIndex: i, totalScenes: scenes.length }\n}));"
      },
      "id": "a9",
      "name": "Determine Scenes",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1760, 300]
    },
    {
      "parameters": {
        "batchSize": 1,
        "options": {}
      },
      "id": "a10",
      "name": "Loop Scenes",
      "type": "n8n-nodes-base.splitInBatches",
      "typeVersion": 3,
      "position": [1980, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://app:80/api/n8n/trigger",
        "sendHeaders": true,
        "headerParameters": { "parameters": [{ "name": "X-N8N-Secret", "value": "n8n-tryonjewel-secret-2026" }, { "name": "Content-Type", "value": "application/json" }] },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ action: 'update-job', jobId: $('Validate').first().json.jobId, currentStep: 'generating_' + $json.sceneType, progress: Math.round(25 + ($json.sceneIndex * 65 / $json.totalScenes)), totalImages: $json.totalScenes }) }}",
        "options": { "timeout": 10000 }
      },
      "id": "a11",
      "name": "Update Progress",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [2200, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://app:80/api/n8n/trigger",
        "sendHeaders": true,
        "headerParameters": { "parameters": [{ "name": "X-N8N-Secret", "value": "n8n-tryonjewel-secret-2026" }, { "name": "Content-Type", "value": "application/json" }] },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ action: 'generate-scene', base64Images: $('Download Images').first().json.base64Images, sceneType: $('Loop Scenes').first().json.sceneType, analysisResult: $('Analyze Jewelry').first().json.analysisResult, userId: $('Validate').first().json.userId, imageRecordId: $('Validate').first().json.imageRecordId, jobId: $('Validate').first().json.jobId, aspectRatio: $('Validate').first().json.aspectRatio || '3:4', productType: $('Validate').first().json.productType, metalColorOverride: $('Validate').first().json.metalColorOverride, customPrompt: $('Validate').first().json.customPrompt, brandDna: $('Brand DNA').first().json.brandDna }) }}",
        "options": { "timeout": 300000 }
      },
      "id": "a12",
      "name": "Generate Scene",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [2420, 300],
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "jsCode": "const result = $input.first().json;\nconst sceneInfo = $('Loop Scenes').first().json;\nreturn [{ json: { ...sceneInfo, url: (result.success && result.url) ? result.url : null } }];"
      },
      "id": "a13",
      "name": "Collect Result",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [2640, 300]
    },
    {
      "parameters": {
        "jsCode": "// Gather all results from the loop\nconst allItems = $input.all();\nconst input = $('Validate').first().json;\n\nconst generatedUrls = allItems\n  .map(item => item.json.url)\n  .filter(url => url != null);\n\nreturn [{\n  json: {\n    ...input,\n    generatedUrls,\n    hasResults: generatedUrls.length > 0\n  }\n}];"
      },
      "id": "a14",
      "name": "Finalize",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [2200, 100]
    },
    {
      "parameters": {
        "conditions": {
          "boolean": [{ "value1": "={{ $json.hasResults }}", "value2": true }]
        }
      },
      "id": "a15",
      "name": "Has Results?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [2420, 100]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://app:80/api/n8n/trigger",
        "sendHeaders": true,
        "headerParameters": { "parameters": [{ "name": "X-N8N-Secret", "value": "n8n-tryonjewel-secret-2026" }, { "name": "Content-Type", "value": "application/json" }] },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ action: 'update-job', jobId: $json.jobId, status: 'completed', currentStep: 'completed', progress: 100, completedImages: $json.generatedUrls.length, resultUrls: $json.generatedUrls }) }}",
        "options": { "timeout": 10000 }
      },
      "id": "a16",
      "name": "Mark Completed",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [2640, 0]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://app:80/api/n8n/trigger",
        "sendHeaders": true,
        "headerParameters": { "parameters": [{ "name": "X-N8N-Secret", "value": "n8n-tryonjewel-secret-2026" }, { "name": "Content-Type", "value": "application/json" }] },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ action: 'update-image', imageRecordId: $json.imageRecordId, status: 'completed', generatedImageUrls: $json.generatedUrls }) }}",
        "options": { "timeout": 10000 }
      },
      "id": "a17",
      "name": "Image Done",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [2860, 0]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://app:80/api/n8n/trigger",
        "sendHeaders": true,
        "headerParameters": { "parameters": [{ "name": "X-N8N-Secret", "value": "n8n-tryonjewel-secret-2026" }, { "name": "Content-Type", "value": "application/json" }] },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ action: 'refund-credits', userId: $json.userId, amount: $json.creditsNeeded }) }}",
        "options": { "timeout": 10000 }
      },
      "id": "a18",
      "name": "Refund Credits",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [2640, 200]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://app:80/api/n8n/trigger",
        "sendHeaders": true,
        "headerParameters": { "parameters": [{ "name": "X-N8N-Secret", "value": "n8n-tryonjewel-secret-2026" }, { "name": "Content-Type", "value": "application/json" }] },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ action: 'update-job', jobId: $json.jobId, status: 'failed', currentStep: 'failed', progress: 100, errorMessage: 'Tüm görseller üretilemedi' }) }}",
        "options": { "timeout": 10000 }
      },
      "id": "a19",
      "name": "Mark Failed",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [2860, 200]
    }
  ],
  "connections": {
    "Webhook": { "main": [[{ "node": "Validate", "type": "main", "index": 0 }]] },
    "Validate": { "main": [[{ "node": "Job Started", "type": "main", "index": 0 }]] },
    "Job Started": { "main": [[{ "node": "Download Images", "type": "main", "index": 0 }]] },
    "Download Images": { "main": [[{ "node": "Job Analyzing", "type": "main", "index": 0 }]] },
