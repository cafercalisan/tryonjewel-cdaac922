    {
      "parameters": {
        "jsCode": "// Validate webhook secret\nconst headers = $input.first().json.headers;\nconst body = $input.first().json.body;\nconst secret = headers['x-webhook-secret'] || headers['x-n8n-secret'];\n\nif (secret !== 'n8n-tryonjewel-secret-2026') {\n  throw new Error('Invalid webhook secret');\n}\n\nreturn [{ json: body }];"
      },
      "id": "validate",
      "name": "Validate Secret",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [220, 300]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={\"success\": true, \"message\": \"Generation started\"}",
        "options": { "responseCode": 200 }
      },
      "id": "respond",
